msgid "Send clipboard text"
msgstr "Enviar el texto del portapapeles"

msgid "Send shared text"
msgstr "Enviar texto compartido"

msgid "Automatically synchronize clipboard text"
msgstr "Sincronizar automáticamente el texto del portapapeles"

msgid "Automatically send clipboard text to this device"
msgstr "Enviar automáticamente el texto del portapapeles a este dispositivo"

msgid "Requires automatic synchronization, the clipboard permission and the send permission for this device."
msgstr "Requiere la sincronización automática, el permiso del portapapeles y el permiso de envío para este dispositivo."

msgid "Send"
msgstr "Enviar"

msgid "Opt in here and per device. New copies are sent only while this device can read the clipboard, and sensitive clips are excluded."
msgstr "Actívalo aquí y por dispositivo. Las copias nuevas solo se envían mientras este dispositivo puede leer el portapapeles, y se excluye el contenido sensible."
