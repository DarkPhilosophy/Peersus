msgstr "Options avancées des relais"

msgid "Direct wait (ms)"
msgstr "Attente de connexion directe (ms)"

msgid "Relay timeout (ms)"
msgstr "Délai du relais (ms)"

msgid "Retry preferred relay (ms)"
msgstr "Réessayer le relais préféré (ms)"

