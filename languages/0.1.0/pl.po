msgstr "Aktualizacja nie jest podpisana przez wydawcę tej aplikacji"

msgid "The update is too large"
msgstr "Aktualizacja jest za duża"

msgid "The update listing could not be checked"
msgstr "Nie udało się sprawdzić listy aktualizacji"

msgid "The update offered is not the release already seen under that version"
msgstr "Oferowana aktualizacja nie jest wydaniem widzianym już pod tym numerem wersji"

msgid "The update offered is older than one already seen"
msgstr "Oferowana aktualizacja jest starsza niż już widziana"

msgid "The update state could not be saved"
