msgstr "Ukryj szczegóły"

msgid "Read the licence and notice"
msgstr "Przeczytaj licencję i informację"

msgid "Cannot read system identity; existing credentials were not changed"
msgstr "Nie można odczytać tożsamości systemu; istniejące dane logowania nie zostały zmienione"

msgid "Cannot read the system keyring; nothing was changed"
msgstr "Nie można odczytać systemowego magazynu kluczy; nic nie zostało zmienione"

msgid "Cannot remember the choice; nothing was changed"
msgstr "Nie można zapamiętać wyboru; nic nie zostało zmienione"

msgid "Cannot save identity in system credential store"
msgstr "Nie można zapisać tożsamości w systemowym magazynie danych logowania"

